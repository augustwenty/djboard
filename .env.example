# Copy to .env — see README.md for details on each variable.

# HTTP port
PORT=3113

# Where notes, uploads and settings are stored
DATA_DIR=./data

# Require this password to use the board (leave unset for no login at all)
AUTH_PASSWORD=

# Signs the session cookie — set this so logins survive a server restart
SESSION_SECRET=

# Set to 1 if DJBoard is served over HTTPS
COOKIE_SECURE=

# Lets the Pi kiosk skip the login page and land straight on Display mode.
# Only needed if AUTH_PASSWORD is set. Any long random string works — treat
# it like a second password. See deploy/README.md.
KIOSK_TOKEN=

# Forces the kiosk's Display mode into 'light' or 'dark', regardless of
# whatever theme is saved in the kiosk browser's localStorage. Leave unset
# to use the saved theme (or light, if none is saved). See deploy/README.md.
KIOSK_THEME=
